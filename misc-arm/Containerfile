FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:aca15268df4706365ee9279e98fe1f505f4057877e418c56e036da8dab8b03c8

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
