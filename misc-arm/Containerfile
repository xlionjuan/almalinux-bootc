FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:a370a51b1c0eb49bd777a9d5cea2da17127b04bb42c1da610b8e1cbca41fce2b

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
