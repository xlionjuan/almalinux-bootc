FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:118ee3b50400895cab6d247fc1ad23c07c33cb31e18173a0a58a8aeef90faf0d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
