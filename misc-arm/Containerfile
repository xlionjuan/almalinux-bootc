FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:647016119d4989ec809d3051b531395d19d317fdbd73b08e00879124b646103a

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
