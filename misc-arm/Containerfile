FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:cd22688b60d7c037a178644b7986eccdc01817366c6c20220cdf80bcbe7c003c

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
