FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:5569fe996caedb15d173f1e91a38369a68873e5945acda0fb925fa54422e49cc

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
