FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:0b89972743e7e5354c7271a3359c79d8dd66081f0f93247b78d92c298a82811d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
