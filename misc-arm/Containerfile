FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:ca1b3834e970ab201c491231b28350b77b36206aec26453fc6319d9c9f3bd134

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
