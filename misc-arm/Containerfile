FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:a9a05ab15c1345fb4c529ad92cebfb1e06a8246a53ac30790e130077ff2bf0f9

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
