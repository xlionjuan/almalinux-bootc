FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:b3cf7f6af753f353527ee32edfca5c6865d8820cb2ef4a8269f0f8fbe59f183a

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
