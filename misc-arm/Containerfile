FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:ee396d5aa8843c1611bf96e767f272987b89e27902ab4efc65fd2e28b4b87ba9

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
