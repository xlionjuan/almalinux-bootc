FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:06d09b550731223f197de1319f39b8695f4c09aa0d25558a2df9cf308abe4ef5

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
