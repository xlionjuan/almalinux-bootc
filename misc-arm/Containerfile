FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:3b2076ea2b81f0c9d10c8263c2d9f1cd821d657dd6ba70a3d132e5457d7dcba0

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
