FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:a5682cc624b383f14a14a9026e7f21507084b29545e70dad92d8baba465234a9

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
