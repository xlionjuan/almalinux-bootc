FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:6e35f755544f0ab6a17087ca6b491fa3e1dd7915f68901bfc989dee105ce4c38

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
