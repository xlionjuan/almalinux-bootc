FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:0325681e13cef8fa42e5deacf6987aefa6f584e3483803d4c8affcfba10ddd60

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
