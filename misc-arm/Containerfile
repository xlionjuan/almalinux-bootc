FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:38ff18effc70868148fdedef383ba725681a5f9628e9c6dd65ac5b45a9db93c0

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
