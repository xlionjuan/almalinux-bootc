FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:684c78ba49871effcb07d8ef981d32b627e15872073c7ad587cc7d119182f675

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
