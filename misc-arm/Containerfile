FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:b862dda866e301e64fc03ffcc4f75d86fc2580188d54bdb31d59f4ee3092932a

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
