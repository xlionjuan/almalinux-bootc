FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:9eb54514a2ccd0549a71a55502b0db40ca45988c42acaee6d9314e0dbce11dfd

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
