FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:655c15b305657ece2500b03c0634ac0c9886b8dc87aef66950489e915c7ce73f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
