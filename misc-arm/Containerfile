FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:2de4ceef7f66fd7b5f5451ef39856c1a59fde2e27782c6fe34a3c4d8e5092c74

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
