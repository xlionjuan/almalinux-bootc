FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:da354fa8671c6457faf369d355033c6e6010c662ab80961955f4c9e17afd8ade

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
