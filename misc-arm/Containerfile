FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:f7973f84c2a645c8b2ab14295e97cee1857b1dbe0f8b92983d4446bdaacde5c3

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
