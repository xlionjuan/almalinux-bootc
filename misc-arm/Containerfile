FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:888c720730a3303ad26303aa42f1c450c12403414a6918953e13b4c2a7f1bdbb

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
