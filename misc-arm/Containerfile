FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:2bd490a291af924136fff41fbddf308a2bf245b3b8acb97af9e00f3d1355e2ae

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
