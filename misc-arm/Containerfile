FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:ad16643e64fefa74f6bae179e8e1b00a25f6615a6327fa241700e144e4050801

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
