FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:afe3fb07a6f8755ba622bb59f910155d7ce6642c0bf7d616989659b17eedff47

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
