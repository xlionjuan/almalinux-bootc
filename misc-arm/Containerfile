FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:0f9b997cac490e1e5e95b9a7c2fea2e88507a19a8efb7c74d2609f606dc4ccab

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
