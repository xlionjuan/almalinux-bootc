FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:a9bfc2cd466857d2a99f77d1d1309a692f487e88e6296ac8a3888f64d71238c9

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
