FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:1640c925174de24def2c339a8aeb67208fb8b98fc01c658227ede79bbd20c39d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
