FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:c461b7abe7640d395261c8d0669bc9aae50436f64930369824bb4d077ec0adfd

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
