FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:86cd7b3683418f70d22d7ff8971731946737b7ca4bb8b24723b8672f8737cfd3

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
