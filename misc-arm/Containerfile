FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:55847a43e4585383c92ff65e0158ec933673741a152511c7bb403bcf7ee8d1f1

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
