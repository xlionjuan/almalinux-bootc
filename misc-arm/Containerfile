FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:e0abc5c815ea25276c0f0c77653e418ffcbf2b8a36a669ae540124d07d976e21

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
