FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:3e78e2dc5f3c159b99fa1b56d941250531c770a3fc2922f50902d17aa763d7da

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
