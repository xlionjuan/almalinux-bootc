FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:78a1a03b8822759dc20b52751b53ac6a2d71b5634139d9b08835ef097d09d6f7

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
