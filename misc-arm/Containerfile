FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:b5a45ffdd0bbd9927ba85ac371aeecdbfcd80ee3da47f61b326e83ca38b06e2c

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
