FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:940171aba7d17a30e6026c8454ff2dad7822584384516f532effaf6f5cdc21c0

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
