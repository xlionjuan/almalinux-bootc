FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:298e5f814b9de946270c5dfba942c4003eb55f16a124fe427afe6749f203442d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
