FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:a997a4aa3ae74818f60f5c8498536af7b84efb1a288077aafce0a9aeb0c3c22d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
