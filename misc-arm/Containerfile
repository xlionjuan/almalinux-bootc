FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:2e5aaf57524280c45e62a94ea85fefd52449a738966517d6a9b5c6e8d27d2c1e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
