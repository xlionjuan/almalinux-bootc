FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:9c8fea11f7fd3d31988949da0f5143994d09a24bca3a9ddd963442d04d73e0e4

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
