FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:52e7c694f94bd0667689ab3500bd7d0280248efc9eb56a3f22f159c363940199

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
