FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:73ad16643e493a57a29b957303cdf6f0742250bde484c202c40975c883be74ad

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
