FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:20408cdbacbdcc69f61b99b3a78891919c5f0acba4f12e36834bc045c948d2ea

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
