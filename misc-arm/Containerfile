FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:276bdf20835295c0003389aced689379209dcfd42c2077810739c9d49790a7b9

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
