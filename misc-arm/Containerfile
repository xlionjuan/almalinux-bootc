FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:ab6bf95ebaf4eb8a87bc4655b30b879e490555b76bba4b4277728ff229858fc8

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
