FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:743da335d50a692287d3d7bc106beb4cf364d1367a3573d49df61c7d2779e6f8

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
