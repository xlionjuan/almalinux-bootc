FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:40afdab371596f071b21a6675af0a92db655f21783bcc9f366b36714b83aef0b

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
