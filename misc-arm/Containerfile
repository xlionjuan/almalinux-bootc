FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:7b524f486da85d27a701c2fc3e073916f928a8f848a976d24ff6eb5b1ff0d067

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
