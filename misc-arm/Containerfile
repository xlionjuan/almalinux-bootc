FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:0571adcf5be29a02046275d45860d3d4c7d1a7c0233f30e5cad60b413bf9f5d6

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
