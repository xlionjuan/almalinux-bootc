FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:9c81c74138c82e8aa0e3d41086874cce82742f320422ec1d99511d9be1fc264f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
