FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:cc8b3a839818ee7632b112bccd7378eaf7abef01c20d9f70d09e408777164807

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
