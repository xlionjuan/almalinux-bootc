FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:af9dbc8fd5783e86bb046f43378369af9a8542bf47409b28696272954cfc55be

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
