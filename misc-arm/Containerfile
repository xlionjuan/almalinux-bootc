FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:f610b00550b85c98fa18255d4fffb01ef68149a78aafea629ba9544b209504f4

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
