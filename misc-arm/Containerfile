FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:e685d369a5e863c6cd8ccfc5b4a37d9ad99c8f86c867f76294651f13658b87fb

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
