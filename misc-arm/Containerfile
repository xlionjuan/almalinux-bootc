FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:5ea0dfa160a6c90592473be163dc9caad3649be7442addedc4a8508c5906ef9a

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
