FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:6d51a486c43d08635315e273caed0681f8c9c7d9a4e2f82629e86e5c2539da8e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
