FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:fc79964c1fbf24a57cfa87d386fa2f9c508230978c67f1263247804d1c5d05e6

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
