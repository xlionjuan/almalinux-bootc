FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:284387be218ef89a21450c24b70968adfbf63993a53f45eea6339c1feb6c6f27

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
