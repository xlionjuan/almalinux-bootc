FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:0f071636cb9a0297a10f68671774863a61f58a1f11bf771dcbf7b73db57cfac4

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
