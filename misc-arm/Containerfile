FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:382546c6ef981792a5abf5c60893001b092d8479293ff95be21db613f71635be

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
