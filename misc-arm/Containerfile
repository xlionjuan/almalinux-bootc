FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:d3f959b64939f418e282ed9e6d9ab913cf63755db9c8d3cf803550480d493d89

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
