FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:5235eb1b5154716060059cdf8fceedb3fce6dc7bb79df8c3befe853a8737662a

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
