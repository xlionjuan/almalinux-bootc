FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:636bb24dd237d286d670454a06ef260275142eac4ea2bd50af62d00c4dbcb2b6

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
