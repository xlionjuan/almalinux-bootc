FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:033bd78745139f8215c78158646b6116df4aa6f6c5f1f0c4d26af0b8d3aa31cc

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
