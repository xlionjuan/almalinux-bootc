FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:bcb82caa62f4a5962669db1a05c2d5f869820eacdc5ce9f9e5730b1140aba861

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
