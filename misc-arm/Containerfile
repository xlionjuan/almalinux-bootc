FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker-arm@sha256:978b72f0abcede3f0c52c5feebb5e3cbf3f27263d1127a436ee0dd0589be1b02

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
