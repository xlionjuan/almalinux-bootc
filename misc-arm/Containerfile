FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:7a07693895b863c544fd0e22a63b77863b95707386021cc6c93c126b26d88b0f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
