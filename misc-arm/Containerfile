FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:f031212083a147b942c4b0bcca080469048bf378fc08a0d49c986649916967e0

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
