FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:18c9a03e65a0d136c1c78aa0d0a4cb87ebb590f9229e058daf64aabce34b9335

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
