FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:3350084605bd610a981ace0f12a78dc2b21d8fa2a5030db2bc4febce8c6067d3

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
