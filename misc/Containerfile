FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:32d274acc50aa01ac9a10c1587150d835278bef49020ce1d817d838480460559

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
