FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:87bc788624981d32decc44569ebc9ed685e00f4aeb64940f928512fb921e1bb7

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
