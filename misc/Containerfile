FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:582c57f510b4e4c9426f082919579fda581b2e76559f5cf1f96b9bd474d4e3a5

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
