FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:098de6eaca6b1456873be5b143707430213496b6184c6645bc18a851e41460a9

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
