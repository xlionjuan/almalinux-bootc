FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:968d086f9e9e529e7f905ffd81bf7e2723e6902af1e49cbdb33ab6e9c979163f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
