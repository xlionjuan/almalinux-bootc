FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:9449a7564d3ac4a8c3765af04dc57c7939d1cbac26198d134f1d2df3adae89dc

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
