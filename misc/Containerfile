FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:d9170027583179d10ce1d2cf2e8dbfaa55a6b9612e45898e95b1d251774a848e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
