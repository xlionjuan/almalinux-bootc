FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:27a3c66312b682a6269cb8dcae6b0d82ec6bfefe0436468a49655a96a7326b70

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
