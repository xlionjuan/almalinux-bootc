FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:296bd16265498a51c6bbfad3c6eb58f40ebe659589901450f58cb94dcfad99d1

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
