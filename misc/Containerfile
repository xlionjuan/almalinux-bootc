FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:c6df69821d44ce46382d08b0ec1a9cf8df0030f96d2659147524857d59eee84f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
