FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:92d7a391994997e321fbc999f9581af24bf15b1b026e742556ccc8dd63113908

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
