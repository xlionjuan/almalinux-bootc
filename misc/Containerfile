FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:6dc87fc5d8c053227180147c32138195f415858f50b4a51c32bc355186655466

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
