FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:42463599748caa9eef304a9eb042db39c0bd538b83256fd7ee1c73d5fcc626c8

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
