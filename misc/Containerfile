FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:44d2c9368a5055556b59521c6bd4d075b6558d9191d9586fd0af4b2ce606e45f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
