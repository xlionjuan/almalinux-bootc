FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:b274b98d70b2887c008f6702577459ebe28889b20d39766b53c3c22e49d1e36e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
