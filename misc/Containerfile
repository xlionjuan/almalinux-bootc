FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:95e7b9a28f3060fccda468d86f432ddf0b0531959cef3d5aedc658eb610c715f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
