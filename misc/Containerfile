FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:3ef424fc62370ab03fa321f96f95f95f761431d2f7772c27825d0fabc3ed3baa

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
