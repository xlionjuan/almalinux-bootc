FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:258a907f4ad0798ac1f9d1343a203a4768a79f0dbde62bc8d50ef5ee81adeb69

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
