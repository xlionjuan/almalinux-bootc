FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:171a80fcd8ec4361cc6f7a099cdd912e48cbca57157f144f0d0dea5f999907a3

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
