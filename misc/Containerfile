FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:208c27dd9e389a7dc546c5a3d7acbb19a9e84cb9abcc06e748bd8a2a4d1401e5

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
