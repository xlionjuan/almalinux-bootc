FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:2ceabe30cbfd0d88adb82a0d538607396676f167f8ac5871698a079fe47d1028

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
