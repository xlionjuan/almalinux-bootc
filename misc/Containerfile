FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:8d9b6c48e7cd5b5b74744f08c7aa6053ae328c9cf2261b9abefa321a866ab7b7

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
