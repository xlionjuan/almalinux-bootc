FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:eb313281fac679612160ea3e7af0444b55b9e31d74626ab6aac595bd6e104756

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
