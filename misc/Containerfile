FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:0302bef8053e6ff0fc5a0c5a9a6f4304ee324e481103cc4e92c44175b070c15e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
