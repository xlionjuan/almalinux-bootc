FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:e28d9114efe1792ccbeee58afc7fc559610fb13c205b20c5a87ec57f849e0531

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
