FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:2b5cb9ba704a546704ce0df13af94ba267e3c7d638417a708a4709a980e3214c

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
