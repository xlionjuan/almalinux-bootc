FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:ac5599b279a3443f6d88bc6b61a6f2d11d31c95750081bb2c22635bb23eadcf2

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
