FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:b4cb7460c54c02d9b4ad145e92c8895268bc50515eed0d44c8e5fe25e5208d11

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
