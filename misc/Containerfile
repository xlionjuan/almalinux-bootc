FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:928e741fe416090aeb0941b97184a25b4bc50b1379dc40d11cd19f892042ad99

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
