FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:d5e61770fff288bf1d55a915baf54d00fb35acba4ed0ea12e77eed44a74db387

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
