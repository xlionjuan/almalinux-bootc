FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:4ed88a2ee6e05e0c99f6b51c9b439b35914232c2b467b4951f6ba70e29535d47

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
