FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:d97b84d2f57f22029a86fc88c8a691a61c8afeb3b4c3fc3a8fcc7e4d0d3ac969

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
