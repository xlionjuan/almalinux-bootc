FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:68e321224e93f619830a756dfdf6a3fc0b5e079852b8ca2ff60378d177836f2d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
