FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:7b5d48861a64da9c186cf7d1979e83629bb0c355c14b3e4db6e289fb67fd36a8

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
