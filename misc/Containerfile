FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:ca07dde4d077d68383321e550f88cdd2ec2671613384896363f78cd954186c42

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
