FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:0dc9b73adbc890658dc873526b8aa21f755928682e396f8486d9a338e6504e42

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
