FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:affb17a952c0f61ad9d9f297e80c779e0f182162b0676d698a002b6318a157fe

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
