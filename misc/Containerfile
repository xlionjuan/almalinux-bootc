FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:9a41500a530b4255bac89d306d883a4547289cdad343c9ce0f6ac778dc5bae02

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
