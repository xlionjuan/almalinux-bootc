FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:e3321250c1b64a42abc695c950489b65738c00697f41f2bcdfd6ca59b87048aa

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
