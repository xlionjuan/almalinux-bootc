FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:c739a68180b0c1a1645668fb773b6b32592fde55fc17d54c31afce72eb146aac

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
