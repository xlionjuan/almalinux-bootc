FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:d03d0749d1fd215c6b80ce20a6c98e607fb9416b6f98e6532110542e6bd654d8

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
