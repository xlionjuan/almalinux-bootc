FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:5aee070f9ba043c9d1b9c2dd55489d517492ead6b6b058628f59465d78393019

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
