FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:aa32f6ae2c6e326d93b7bcb1e9ce0b065ffe1195b17520620bb2e10e99d6fbac

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
