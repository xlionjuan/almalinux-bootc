FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:7e1e402fde361203dc5f6acd93f4eec37242529e9248dea054dfbe8a0eab8d1a

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
