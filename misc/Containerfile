FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:50f6c427fb70b70df6a3b1b13c9b33e44c426659f069b83aa354f9fa406369a3

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
