FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:5197dec347c003be07804d60be476393a1cfb7cfec6a2a5b4feef83eb2acefdc

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
