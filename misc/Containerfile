FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:73661c720bb502e6785919629d236a39fb85885624f0e60d55175ced96a80460

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
