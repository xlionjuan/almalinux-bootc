FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:06197b55075a1d2c3fae84aca39331ce5b25e8fed1feacbbc333a6a117f21a7f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
