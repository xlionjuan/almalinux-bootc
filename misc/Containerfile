FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:eb97ab806502470331c7a4cf6d87e122f97b084efafa6b6ae733267dc835b70b

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
