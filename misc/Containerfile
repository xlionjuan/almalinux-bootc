FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:1e8c147e542735373e67df100e041e856571f3f3e0bd9cccaf3fd74a34bb5a22

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
