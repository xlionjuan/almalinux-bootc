FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:c388ca80bcc31000f345cd68bc1050259374eb6be31d368d8acf000d8caeb095

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
