FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:3c26c0a3ac433c267cea6833511f19da45aacfddb5cc4e6eff8fb2d38062cb71

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
