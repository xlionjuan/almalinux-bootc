FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:6622ce0eae8a00503b998d3995f1c58ab55346d4600d735f2f4fe7cfff6b4776

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
