FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:5a8bad29ad6344196e2ae83f14133f94b662689d3b9e7ffafde91a36749aea08

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
