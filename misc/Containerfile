FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:bbac6984fc48cc6ace4c174f5e013712cee2f544028697b6feee0fe3bb2651d3

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
