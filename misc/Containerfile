FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:ccda4a59820c341f67ba696eb00ed5d80e7ae4b7742f7ed44655ea5ceb244d54

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
