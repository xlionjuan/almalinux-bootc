FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:b31f67025edca84ab6934677c72ac85c1207bea3d4701cd4897c7edc49e45293

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
