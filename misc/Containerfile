FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:b20ed747469cbcaec60ac954c78691ef5d721501ca8826c2f1ee99aaee55464a

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
