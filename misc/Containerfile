FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:3931a7a3d46787d7dcb3f4a959088c020f81eb047035220cf3cfecc744879268

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
