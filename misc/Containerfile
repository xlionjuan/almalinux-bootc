FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:a9ac01918348779a7bbfe0718a516c09a9efa6ff82be8b232fba37033fdab0f2

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
