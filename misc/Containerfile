FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:6bea39f5ff520cba0d475e72307fc4a66a3f722ec31f4dc7c5bfeb5706d80b16

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
