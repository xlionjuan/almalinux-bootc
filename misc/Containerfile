FROM ghcr.io/xlionjuan/almalinux-bootc:base-docker@sha256:0016c21ec4f14536b0598cdc7c16826607f9c1e952aa815e9db59aedb536b303

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
