FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:dc3e4f344040c9532c105e5935f3042c7c3f86cf03ed2dbcea0ece1d2d4c27bd

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
