FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:252e6789dbccb52a4d9951ebcdc2ee9c193ba442588a87d4aca7a14dc45205ab

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
