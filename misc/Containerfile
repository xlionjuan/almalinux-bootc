FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:1dc0463dcbe435a316dac2b2bea40e2a41e74dd07f869b7248f108234a287ea6

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
