FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:a560a8263d22aed21974381d4cb461c576733b93e267b3fd204b89b91b5c2fdc

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
