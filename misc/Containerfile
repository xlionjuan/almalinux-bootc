FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:7488cbdf09331a1733f4e4ec9e901268075f1841d604688276b9e74883beceaf

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
