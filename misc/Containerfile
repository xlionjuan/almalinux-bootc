FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:3afbdf85f7f6dddbcd329079c858c0a1568478555bc3e34ebfeaa96f902556a1

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
