FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:d214c5b8c0d02126540673cb37f5e567424426d936c16481c969645d640b0b12

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
