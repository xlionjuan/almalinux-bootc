FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:0c6fdefefa9b0a73b464554627c577c55279bad436686e75ef952959f4980fe9

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf \
        /var/lib/dnf \
        /var/cache/* \
        /var/log/* \
        /var/tmp/* \
        /tmp/*

RUN bootc container lint
