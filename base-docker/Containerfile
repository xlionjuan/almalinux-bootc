FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:5badae0b6b3a3278850e3aa29d0da244b2a96b3c9aa92f8916cff6d1ea0e09aa

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
