FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:0218ec3871996d26676e3f51c3c39d314187ba9053261d41aef7018362bad494

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
