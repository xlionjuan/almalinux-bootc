FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:46df5d470ead6b830611fef0b5336e9bb7f6406de9ded1854b16a4b3759ee041

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
