FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:5eada73b92446dd8aba9ace6eb1a841fc1efa9a11611898f9853a114fe680f2f

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
