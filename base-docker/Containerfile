FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:338a61eb9a530e61cf48865338d4f946c53e7ebdf81f845f6cf6819b6bbc72fd

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
