FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:a0cbac53111d5ef517b6296e4935ace6ed095a029a49ad24fc6cb82dd2ead0b3

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
