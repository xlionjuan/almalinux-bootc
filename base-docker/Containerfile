FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:7c615460d56337cb2981bbe8759b34efca90d01c398ec34b0e6c3974e63aeef5

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
