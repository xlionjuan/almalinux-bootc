FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:4a432ac0e7b80b7c7ab4ad9a4066b1671b8f5b578e332d3af8c6c2e1518751a1

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
