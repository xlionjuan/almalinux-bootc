FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:9c2d749e88a76c3e720af9b9d8c964020e1e3c7552bf72e07f12e2e51200a1f7

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
