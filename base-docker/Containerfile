FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:c1dbdb1e97bdba08e5fb5261fb3f9477070c0382a1ed2c5611cac2634b9312da

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
