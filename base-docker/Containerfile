FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:b3e046183ec5db1b47c2a1daad29bab132bbfe15e5433ece98b337890940c34d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
