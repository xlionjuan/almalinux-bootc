FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:a54421a9757b86c66c9064f415375407aaca339d5fe5a374eb06cdb75c8b0223

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
