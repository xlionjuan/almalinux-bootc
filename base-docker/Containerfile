FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:042a64436ca4d04af53110302449c574352569841c20fdf6f509ed3f628e9819

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
