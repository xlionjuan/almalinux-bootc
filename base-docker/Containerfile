FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:f36d3a6328501e4561dcff7536022894d10450c7d96d9832522bf91bf40ad2e5

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
