FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:b71d3cfb15330fa674344b443acfdf84f14bf8643639c08fd4cdd942bac3c97e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
