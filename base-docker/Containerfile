FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:29e4b8c28a2be02d120fe8f08c051d35b635b5d10a198ff78c1dc75a206d0e83

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
