FROM ghcr.io/xlionjuan/almalinux-bootc:base@sha256:543709218c6a070caee8a3d0c70500afde2ffca4999828676434b4b6590243b5

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
