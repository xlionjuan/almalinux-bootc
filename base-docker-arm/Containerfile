FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:64088fb5c9d4c314ed07626f2dfa45b13115f82ae7900d57d2af215ae5dba17d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
