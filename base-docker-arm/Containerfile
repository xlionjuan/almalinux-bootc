FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:03927ed206dfa7b494400cf7d56f35a65ac9c6c746c6a12a3026d64d07da312d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
