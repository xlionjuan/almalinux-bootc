FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:baeded8d54f3c9a3cc779d85e8f3506a33c6f95ee37ba7b502567abf4659a1fc

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
