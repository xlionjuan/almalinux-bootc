FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:3576fa9c1a9370042b4e9447d934a6ef5fb1ab99edcf25bed6480198dbed7e3e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
