FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:9fe92f661db30f52fdf2e5e55f1ca287ba198a11a8f814250ba9ade3d3d259e5

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
