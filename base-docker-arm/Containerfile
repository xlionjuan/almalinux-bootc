FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:1ca7763f5fa0f80dbd3e0ab5b58e2606b95fd5c99442f9d49a2c60c58fdd9fcd

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
