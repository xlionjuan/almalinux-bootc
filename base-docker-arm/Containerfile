FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:0740aee03bdfdecbb657c4757ccfef2ad4f0626c3f7cb2a58d9297fb62ac1f6e

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
