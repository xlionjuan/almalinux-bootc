FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:e7f2a81cdea6756fa4bab2ecc243b63fbc23ed84b8002592e6cc7a374278d800

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
