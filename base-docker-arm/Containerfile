FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:8a89eb6647005dd55eef961d3e136dc8af1a23b51bb4ac36531deb8eba65e01c

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
