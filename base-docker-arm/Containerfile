FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:2de3a1f2c83604c49766c2f991dd4596ae29898f083fa230d0a78627ba852cef

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
