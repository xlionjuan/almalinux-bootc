FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:27ea07e9f8fdbfeb6fd59f9f7ff64c5fa0b56bf7176d882ca00e93135deca76d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
