FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:71f3235e9d4ce638255d0c8f64e0fea7fab1c3306945ce2553dea3773819f551

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
