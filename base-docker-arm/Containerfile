FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:163fd8a762130f4cb0658817c488e1d86be6ba258d2ea189f3eeba2baf746e77

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
