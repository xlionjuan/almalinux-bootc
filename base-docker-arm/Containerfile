FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:5347025d802ec92cd8c6a13e84c0c929d17fe0f74e76af895aff765bd3d1d260

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
