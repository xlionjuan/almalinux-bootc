FROM ghcr.io/xlionjuan/almalinux-bootc:base-arm@sha256:c191cf91d579b3293de00ba5c210c45de5f5d31eb2fbe0af1ebd54ef32c5de5d

COPY build.sh /tmp/build.sh

RUN mkdir -p /var/lib/alternatives && \
    /tmp/build.sh && \
    dnf clean all && \
    rm -rf /var/log/* && \
    ostree container commit

RUN bootc container lint
